# Copy this file to .env and fill it in. Every value below is a placeholder.
# Values set in the process environment win over this file.

# --- required ---
# The mailbox that receives your Upwork alert e-mails. For Gmail: turn on 2-step verification, create an
# app password (16 letters) and paste it here; spaces are fine. Prefer a separate mailbox that only gets
# Upwork mail through a forwarding rule: an app password opens the whole mailbox.
IMAP_USER=you@example.com
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
# From @BotFather in Telegram. After the first start, press Start in your bot before anyone else does.
TELEGRAM_BOT_TOKEN=123456:replace-with-your-bot-token

# --- optional ---
# Another IMAP server instead of Gmail.
IMAP_HOST=imap.gmail.com
# Pin the owner chat to your numeric Telegram user id; empty = the first private /start becomes the owner.
TELEGRAM_OWNER_ID=
# Your profile (see profile.example.md). Relative paths are relative to this folder.
PROFILE_FILE=profile.md
# Name that signs the drafts; empty = unsigned drafts.
FREELANCER_NAME=Jordan
# Language of the model's notes for you (why / risks / summaries / translations). The bot's own texts and
# the drafts for clients are always English.
OWNER_LANGUAGE=English
# Comma-separated keywords of your niche; they order the queue and show on the card. Empty = built-in list.
NICHE_KEYWORDS=python script, telegram bot, api integration
# Jobs below these budgets are skipped before any model call. 0 turns the check off.
MIN_HOURLY_USD=15
MIN_FIXED_USD=30
# Daily summary: an IANA time zone (on Windows: pip install tzdata) and the hour, or off.
SUMMARY_TIMEZONE=UTC
SUMMARY_HOUR=21
# At most this many Claude CLI calls per rolling hour; the rest waits in the queue.
LLM_MAX_PER_HOUR=20
# Full path to the claude executable when it is not on PATH (for example under a service manager).
CLAUDE_PATH=
# Where the database, state and logs go.
BOT_DATA_DIR=data
BOT_LOG_DIR=logs
# 1 = keep raw copies of the first e-mails of each notification type in data/samples/events (to tune the
# rules). They are real e-mails: keep them private.
SAVE_EVENT_SAMPLES=0
